---
const { name, img } = Astro.props;
---

<div class = "dispenser sous-section">
    <h2>{ name }</h2>
    <img src = { img }>
</div>

<style>
    
.dispenser{
    padding-inline: 15px;
    margin: 0px 10px 20px 10px;
    width: 300px;
}

.dispenser h2{
    width: 90%;
}

.dispenser img{
    border: 1px solid black;
    border-radius: 5px;
    width: 80%;
    height: 350px;
    object-fit: cover;
    margin-bottom: 8px
}

.beer-dispensers button{
    margin-top: 10px;
}
</style>