---
import Image from '../assets/Background.jpg';
---

<div id="container">
	<img id="background" src={Image.src} alt="Background" fetchpriority="high" />
</div>

<style>
	#background {
        width: 100%;
        height: 100%;
		object-fit: cover;
    	filter: opacity(.5);
	}

	#container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 120vh;
		top: 0;
		left: 0;
		transform: translateY(-10vh);
		z-index: -1;
	}
</style>